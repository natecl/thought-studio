{
  "version": "1.0.0",
  "direction": "primary-play",
  "status": "accepted",
  "color": {
    "chalk": "#FFFDF8",
    "black": "#111111",
    "studioBlue": "#3F6EDB",
    "vermilion": "#E74E3F",
    "sun": "#F2B93B",
    "leaf": "#3CAC6E"
  },
  "font": {
    "display": "Bricolage Grotesque, Arial, ui-sans-serif, system-ui, sans-serif",
    "body": "Atkinson Hyperlegible, Arial, ui-sans-serif, system-ui, sans-serif"
  },
  "type": {
    "display": { "family": "display", "fontSize": 64, "lineHeight": 64, "fontWeight": 650 },
    "heading1": { "family": "display", "fontSize": 40, "lineHeight": 44, "fontWeight": 650 },
    "heading2": { "family": "display", "fontSize": 28, "lineHeight": 34, "fontWeight": 600 },
    "title": { "family": "display", "fontSize": 18, "lineHeight": 24, "fontWeight": 600 },
    "body": { "family": "body", "fontSize": 15, "lineHeight": 23, "fontWeight": 400 },
    "label": { "family": "body", "fontSize": 12, "lineHeight": 16, "fontWeight": 700 },
    "metadata": { "family": "body", "fontSize": 11, "lineHeight": 16, "fontWeight": 400 }
  },
  "space": {
    "unit": 8,
    "rhythm": 24,
    "field": 96
  },
  "canvas": {
    "background": "{color.chalk}",
    "microDotColor": "{color.black}",
    "microDotDiameter": 1,
    "microDotInterval": 24,
    "majorReferenceInterval": 96,
    "microDotOpacity": 0.035,
    "minimumEmptyChalkRatio": 0.96
  },
  "line": {
    "hairline": 1,
    "illustration": 2,
    "color": "{color.black}"
  },
  "radius": {
    "compact": 10,
    "surface": 12,
    "floating": 16
  },
  "shadow": {
    "lift": "0 1px 2px rgb(17 17 17 / 0.04), 0 8px 24px rgb(17 17 17 / 0.025)"
  },
  "material": {
    "colorMarks": "matte-gouache",
    "gestureLine": "imperfect-marker",
    "canvas": "calm-digital-chalk"
  }
}
